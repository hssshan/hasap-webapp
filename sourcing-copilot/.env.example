# ─────────────────────────────────────────────────────────────────────────────
# Sourcing Copilot: copy this file to `.env` and fill in what you have.
# EVERY key is optional. Missing keys only switch a feature to manual mode.
# After editing .env, restart the app (or, for the bot only, Setup → Reconnect).
# Never put passwords here: only API keys/tokens.
# ─────────────────────────────────────────────────────────────────────────────

# --- App security (set both before putting the app online) ------------------
# Password asked once per device (cookie lasts 90 days). Empty = no login (local use only).
APP_PASSWORD=
# Random string used to sign the login cookie. Generate: python -m app.cli secret
APP_SECRET_KEY=
# Set to true when served over HTTPS (makes the login cookie HTTPS-only).
COOKIE_SECURE=false
# Your public address, e.g. https://copilot.example.com (shown on Setup; used in the scheduled task).
PUBLIC_URL=

# --- Telegram bot (free, from @BotFather) ------------------------------------
# Unlocks: weekly digest, trend alerts, "sold 2 hamster 250", /top /stock /profit /orders /shipments,
# sending order lists to your person with status buttons. Starts automatically when set.
TELEGRAM_BOT_TOKEN=
# Optional: comma-separated chat IDs that are always allowed (you can also approve chats in Settings → Setup).
TELEGRAM_ALLOWED_CHAT_IDS=

# --- Telegram channel reader (optional; free from https://my.telegram.org) ---
# Public channels are already read free via their t.me/s/ web preview. These add Telethon for more history.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Created by: python -m app.cli telegram-login   (one-time; you type the code Telegram sends you)
TELEGRAM_SESSION=

# --- Claude API (AI) — https://console.anthropic.com -------------------------
# Unlocks: screenshot reading, review summaries, smarter noise filter, Chinese search terms,
# one-line explanations, Turkmen/Russian captions. Monthly budget cap is set in Settings (default $5).
ANTHROPIC_API_KEY=
# Small model for classification/short text, vision model for screenshots (defaults shown).
CLAUDE_MODEL_SMALL=claude-haiku-5-5
CLAUDE_MODEL_VISION=claude-sonnet-5-5

# --- YouTube Data API v3 (free Google key) -----------------------------------
# Unlocks: daily scan of Turkish & Russian Shorts. Free quota 10,000 units/day; we cap ourselves at:
YOUTUBE_API_KEY=
YOUTUBE_DAILY_UNIT_CAP=3000

# --- vidIQ import (weekly Claude scheduled task) -----------------------------
# Shared secret for POST /api/import/trends. Generate: python -m app.cli secret
TREND_IMPORT_SECRET=

# --- Runtime ------------------------------------------------------------------
# Load demo data on first start (empty database only). Clear it in Settings when you go live.
SEED_MOCK_DATA=true
# Background refresh jobs (YouTube daily, Google Trends daily, Telegram channels every 6h, digest weekly).
SCHEDULER_ENABLED=true
# Where the SQLite database and uploaded screenshots live.
DATA_DIR=./data
# Use Postgres later by setting e.g. postgresql+psycopg://user:pass@host/db (and pip install psycopg[binary]).
DATABASE_URL=
LOG_LEVEL=INFO
